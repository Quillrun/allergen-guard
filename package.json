{
  "name": "allergen-guard",
  "version": "0.1.0",
  "description": "Fail-closed allergen checks for recipes and packaged foods (EU 14 + US Big 9). Never says 'safe'.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "test": "node --experimental-strip-types --test test/*.ts",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.6"
  },
  "keywords": [
    "allergen",
    "allergy",
    "food",
    "open-food-facts",
    "fail-closed"
  ],
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Quillrun/allergen-guard"
  }
}
